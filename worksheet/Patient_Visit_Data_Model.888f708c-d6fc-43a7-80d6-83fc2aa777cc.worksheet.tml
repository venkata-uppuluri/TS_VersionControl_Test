guid: 888f708c-d6fc-43a7-80d6-83fc2aa777cc
model:
  name: Patient_Visit_Data_Model
  model_tables:
  - name: patient_visit_data
    fqn: 5d71e5c5-cb09-495b-98a9-060fee911a36
  filters:
  - column:
    - Provider Full Name
    oper: in
    values:
    - dr. brown
    - dr. davis
    - dr. garcia
    - dr. johnson
    - dr. jones
    - dr. miller
    - dr. smith
    - dr. williams
  columns:
  - name: Account Created Date
    column_id: patient_visit_data::account_created_date
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      format_pattern: yyyy-MM-dd
  - name: Completed Visit Number
    column_id: patient_visit_data::completed_visit_number
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Patient Id
    column_id: patient_visit_data::patient_id
    properties:
      column_type: ATTRIBUTE
  - name: Provider Full Name
    column_id: patient_visit_data::provider_full_name
    properties:
      column_type: ATTRIBUTE
  - name: Visit Date
    column_id: patient_visit_data::visit_date
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      format_pattern: yyyy-MM-dd
  properties:
    is_bypass_rls: false
    join_progressive: true
    spotter_config:
      is_spotter_enabled: true
