  - id: Viz_3
    answer:
      name: Engagement Depth
      tables:
      - id: Brandstore Analytics Model
        name: Brandstore Analytics Model
        fqn: 4d8d9c62-f483-4b05-a3e3-443837ab670a
      formulas:
      - id: formula_Percentage of total sessions
        name: Percentage of total sessions
        expr: "( unique count ( [Session Id] ) / group_aggregate ( unique count ( [Session Id] ) , { } , query_filters ( ) ) ) * 100"
        was_auto_generated: false
      - id: formula_tool usage category
        name: tool usage category
        expr: "if ( [formula_tools per session] >= 1 and [formula_tools per session] <= 3 ) then '1-3 tools' else if ( [formula_tools per session] > 3 and [formula_tools per session] <= 5 ) then '3-5 tools' else if ( [formula_tools per session] > 5 and [formula_tools per session] <= 10 ) then '5-10 tools' else if ( [formula_tools per session] > 10 ) then 'above 10 tools' else 'unknown'"
        was_auto_generated: false
      - id: formula_tools per session
        name: tools per session
        expr: "group_aggregate ( count ( [Tool Name] ) , query_groups ( ) + { [Session Id] } , query_filters ( ) )"
        was_auto_generated: false
      search_query: "unique count [Session Id] [formula_Percentage of total sessions] [formula_tool usage category]"
