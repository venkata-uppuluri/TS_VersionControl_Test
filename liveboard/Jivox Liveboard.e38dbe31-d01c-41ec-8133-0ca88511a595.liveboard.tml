        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"tool usage category\",\"columnProperty\": {}},{\"columnId\": \"Unique Number of Session Id\",\"columnProperty\": {}},{\"columnId\": \"Percentage of total sessions\",\"columnProperty\": {}}]}"
