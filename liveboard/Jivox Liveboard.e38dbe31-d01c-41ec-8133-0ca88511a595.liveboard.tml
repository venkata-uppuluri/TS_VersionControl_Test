      formulas:
      - id: formula_Percentage of Latest Tool by Session
        name: Percentage of Latest Tool by Session
        expr: "( [formula_Each Latest Tool by Session count] * 100 ) / [formula_Total count of all Latest Tool by Session]"
        was_auto_generated: false
      - id: formula_Each Latest Tool by Session count
        name: Each Latest Tool by Session count
        expr: "group_aggregate ( count ( [Latest Tool by Session] ) , query_groups ( ) , { } )"
        was_auto_generated: false
      - id: formula_Total count of all Latest Tool by Session
        name: Total count of all Latest Tool by Session
